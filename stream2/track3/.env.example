# Track 3 settings. Copy this file to track3/.env and fill in the values.
# track3/.env is gitignored: never commit it (it holds private IDs and keys).

# Google file IDs: private, ask a teammate. The files are link-shared,
# so anyone with these IDs can open them.
RPSD_TRACKER_SHEET_ID=
RPSD_TRACKER_TAB_GIDS=Siya:<gid>,Audrey:<gid>
RPSD_FACT_SHEET_DOC_ID=

# API keys (optional, run.py only: it asks if all of these are empty.
# The collection notebook ignores these and always asks in hidden prompts.)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
